{
  "name": "@schady4/quorum",
  "version": "0.4.6",
  "description": "Multiplayer AI in your terminal — friends and multiple AI models share one live chat session on a CRDT + DAG substrate. Model-agnostic, MCP-native.",
  "author": "Jarett Schadlich",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "native": [
        "dist/native.d.ts"
      ]
    }
  },
  "//transport": "React Native (Metro) and web bundlers are redirected from the Node `ws` transport to the platform-WebSocket one, so `ws` and its Node built-ins never reach a mobile/web bundle.",
  "react-native": {
    "./dist/net/ws-impl.js": "./dist/net/ws-impl.native.js",
    "./dist/net/crypto-impl.js": "./dist/net/crypto-impl.native.js"
  },
  "browser": {
    "./dist/net/ws-impl.js": "./dist/net/ws-impl.native.js",
    "./dist/net/crypto-impl.js": "./dist/net/crypto-impl.native.js"
  },
  "bin": {
    "quorum": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "PROTOCOL.md",
    "SAVE-FORMAT.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schady4/quorum.git"
  },
  "homepage": "https://github.com/schady4/quorum#readme",
  "bugs": {
    "url": "https://github.com/schady4/quorum/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts",
    "test": "tsx test/core.test.ts",
    "test:net": "tsx test/relay.test.ts",
    "test:agent": "tsx test/agent.test.ts",
    "test:delegate": "tsx test/delegate.test.ts",
    "test:ledger": "tsx test/ledger.test.ts",
    "test:session": "tsx test/session.test.ts",
    "test:config": "tsx test/config.test.ts",
    "test:router": "tsx test/router.test.ts",
    "test:responder": "tsx test/responder.test.ts",
    "test:durable": "tsx test/durable.test.ts",
    "test:reconnect": "tsx test/reconnect.test.ts",
    "test:auth": "tsx test/auth.test.ts",
    "test:keepalive": "tsx test/keepalive.test.ts",
    "test:e2e": "tsx test/e2e.test.ts",
    "test:vanish": "tsx test/vanish.test.ts",
    "test:tui": "tsx test/tui.test.ts",
    "test:style": "tsx test/style.test.ts",
    "test:sdk": "tsx test/sdk.test.ts",
    "test:persist": "tsx test/persist.test.ts",
    "test:torchbearer": "tsx test/torchbearer.test.ts",
    "test:revive": "tsx test/revive.test.ts",
    "test:native": "tsx test/native.test.ts",
    "test:signal": "tsx test/signal.test.ts",
    "test:blob": "tsx test/blob.test.ts",
    "test:push": "tsx test/push.test.ts",
    "test:summary": "tsx test/summary.test.ts",
    "test:relaypersist": "tsx test/relaypersist.test.ts",
    "test:compaction": "tsx test/compaction.test.ts",
    "test:all": "npm run test && npm run test:net && npm run test:agent && npm run test:delegate && npm run test:ledger && npm run test:session && npm run test:config && npm run test:router && npm run test:responder && npm run test:durable && npm run test:reconnect && npm run test:auth && npm run test:keepalive && npm run test:e2e && npm run test:vanish && npm run test:tui && npm run test:style && npm run test:sdk && npm run test:persist && npm run test:torchbearer && npm run test:revive && npm run test:restore && npm run test:native && npm run test:signal && npm run test:blob && npm run test:push && npm run test:summary && npm run test:relaypersist && npm run test:compaction && npm run test:invite && npm run test:bridge",
    "typecheck": "tsc --noEmit",
    "test:restore": "tsx test/restore.test.ts",
    "test:invite": "tsx test/invite.test.ts",
    "test:bridge": "tsx test/bridge.test.ts"
  },
  "keywords": [
    "multiplayer-ai",
    "cli",
    "chat",
    "crdt",
    "dag",
    "multi-model",
    "agents",
    "mcp",
    "llm"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@scure/base": "^1.2.6",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "ws": "^8.21.3"
  },
  "//bridge": "@slack/bolt powers `quorum bridge slack` only. It's an OPTIONAL peer dep so it stays out of every SDK/app bundle — install it on the bridge host with `npm i @slack/bolt`. The bridge dynamic-imports it and fails gracefully if it's absent.",
  "peerDependencies": {
    "@slack/bolt": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@slack/bolt": {
      "optional": true
    }
  }
}
