  "description": "Multiplayer AI in your terminal — friends and multiple AI models share one live chat session on a CRDT + DAG substrate. Model-agnostic, MCP-native.",
  "author": "Jarett Schadlich",
  "license": "MIT",
  "type": "module",
  "bin": {
    "quorum": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "multiplayer-ai",
    "cli",
    "chat",
    "crdt",
    "dag",
    "multi-model",
    "agents",
    "mcp",
    "llm"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
